{
    "version": 8,
    "configurePresets": [
        {
            "name": "Debug-rpi-pico2w",
            "displayName": "RPI Pico 2 W - Debug",
            "description": "Configure Debug for the Raspberry Pi Pico 2 W platform",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/pico-toolchain-generic.cmake",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/install/${presetName}",
                "CMAKE_BUILD_TYPE": "Debug",
                "C7222_PLATFORM": "rpi_pico2w",
                "CMAKE_MAKE_PROGRAM": "$env{HOME}/.pico-sdk/ninja/v1.12.1/ninja"
            }
        },
        {
            "name": "Release-rpi-pico2w",
